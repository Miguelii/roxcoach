# Supabase project URL (shared project, own schema "roxcoach")
NEXT_SUPABASE_URL=
# Supabase publishable key, used by the session-bound client
NEXT_SUPABASE_PUBLISHABLE_KEY=
# Supabase service-role key, used by jobs and Strava token access (never expose to the browser)
NEXT_SUPABASE_SERVICE_ROLE_KEY=
# Anthropic API key used by the coach
NEXT_ANTHROPIC_AI_KEY=
# Strava OAuth application client id
NEXT_STRAVA_CLIENT_ID=
# Strava OAuth application client secret
NEXT_STRAVA_CLIENT_SECRET=
# Token Strava echoes back when verifying the webhook subscription (GET)
NEXT_STRAVA_WEBHOOK_VERIFY_TOKEN=
# Bearer token pg_cron sends to /api/cron/weekly-reports
NEXT_CRON_SECRET=
# Trigger.dev secret key
TRIGGER_SECRET_KEY=
# Trigger.dev project ref (proj_...), read by trigger.config.ts
TRIGGER_PROJECT_REF=
# Public website url, used for absolute links and the OAuth redirect (no trailing slash)
NEXT_PUBLIC_WEBSITE_URL=
